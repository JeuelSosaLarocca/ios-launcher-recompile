<?xml version="1.0" encoding="utf-8"?>
<com.luutinhit.launcher6.editscreen.LinearLayoutRound xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/other_search_layout"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:backgroundColor="@color/white_30">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_web"
        android:background="@drawable/item_button_state"
        android:padding="10dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:textColor="@color/white"
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/search_web"
            android:maxLines="1"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            app:customFont="light"/>
        <com.luutinhit.launcher6.util.RoundedImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/safari_icon"/>
    </LinearLayout>
    <View
        android:visibility="gone"
        android:background="@color/white_30"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_store"
        android:visibility="gone"
        android:background="@drawable/item_button_state"
        android:padding="10dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:textColor="@color/white"
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/search_store"
            android:maxLines="1"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            app:customFont="light"/>
        <com.luutinhit.launcher6.util.RoundedImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/store_icon"/>
    </LinearLayout>
    <View
        android:background="@color/white_30"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/search_maps"
        android:background="@drawable/item_button_state"
        android:padding="10dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:textColor="@color/white"
            android:gravity="start|center_vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/search_maps"
            android:maxLines="1"
            android:layout_weight="1"
            android:textAlignment="viewStart"
            app:customFont="light"/>
        <com.luutinhit.launcher6.util.RoundedImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/google_maps_icon"/>
    </LinearLayout>
</com.luutinhit.launcher6.editscreen.LinearLayoutRound>
