<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/transparent_button_selector"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="10dp">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/contact_initial"
            android:background="@drawable/circle_bg_light"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:customFont="semibold"/>
        <ImageView
            android:id="@+id/contact_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null"/>
    </FrameLayout>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textSize="20sp"
        android:textColor="@android:color/white"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/contact_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:textAlignment="viewStart"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/contact_message"
        android:background="@drawable/circle_bg_light"
        android:padding="10dp"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/ic_message"
        android:scaleType="centerInside"
        android:tint="@android:color/white"
        android:stateListAnimator="@animator/scale_press"/>
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/contact_call"
        android:background="@drawable/circle_bg_light"
        android:padding="10dp"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:src="@drawable/ic_call"
        android:scaleType="centerInside"
        android:tint="@android:color/white"
        android:layout_marginStart="10dp"
        android:stateListAnimator="@animator/scale_press"/>
</LinearLayout>
