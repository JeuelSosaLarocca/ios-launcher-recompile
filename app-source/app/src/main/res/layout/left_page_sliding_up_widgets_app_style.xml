<?xml version="1.0" encoding="utf-8"?>
<com.luutinhit.launcher6.leftpage.SlidingUpWidgetsAppStyle xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="bottom"
    android:id="@+id/left_page_sliding_up_widgets_app_style"
    android:focusable="true"
    android:fitsSystemWindows="true"
    android:clickable="true"
    android:descendantFocusability="afterDescendants"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:umanoDragView="@+id/left_page_widgets_content"
    app:umanoFadeColor="@color/transparent"
    app:umanoInitialState="collapsed"
    app:umanoOverlay="true"
    app:umanoPanelHeight="0dp"
    app:umanoScrollableView="@+id/left_page_widgets_lists"
    app:umanoShadowHeight="0dp">
    <View
        android:id="@+id/left_page_out_side_widgets_app_style"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.luutinhit.launcher6.editscreen.FrameLayoutRound
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/left_page_widgets_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="130dp">
        <com.luutinhit.launcher6.util.TextViewCustomFont
            android:textSize="15dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/sliding_up_widgets_app_style_item_margin_offset"
            android:text="@string/add_widget"/>
        <androidx.viewpager2.widget.ViewPager2
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:id="@+id/view_pager_widgets_app_style"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.appcompat.widget.AppCompatButton
            android:textSize="15dp"
            android:textColor="@color/white"
            android:layout_gravity="bottom"
            android:id="@+id/add_button_widgets_app_style"
            android:background="@drawable/rounded_button_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/sliding_up_widgets_app_style_page_margin"
            android:text="@string/add_widget"
            android:layout_marginStart="@dimen/sliding_up_widgets_app_style_page_margin"
            android:layout_marginEnd="@dimen/sliding_up_widgets_app_style_page_margin"
            style="?android:attr/borderlessButtonStyle"/>
    </com.luutinhit.launcher6.editscreen.FrameLayoutRound>
</com.luutinhit.launcher6.leftpage.SlidingUpWidgetsAppStyle>
