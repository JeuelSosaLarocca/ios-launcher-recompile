<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:padding="15dp"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/blurring_view"
        android:fitsSystemWindows="true"
        android:layout_width="0dp"
        android:layout_height="100dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.luutinhit.launcher6.util.BackCircleView
        android:id="@+id/action_back"
        android:layout_width="45dp"
        android:layout_height="45dp"
        app:layout_constraintBottom_toBottomOf="@+id/blurring_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/action_bar_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/liquid_glass"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/action_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_back"/>
    <com.luutinhit.launcher6.util.TextViewCustomFont
        android:id="@+id/tv_enable_liquid_glass"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/liquid_glass"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/switch_enable_liquid_glass"
        app:layout_constraintEnd_toStartOf="@+id/switch_enable_liquid_glass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/switch_enable_liquid_glass"/>
    <com.luutinhit.launcherios.customsettings.SwitchView
        android:id="@+id/switch_enable_liquid_glass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/blurring_view"/>
    <com.luutinhit.launcher6.util.RoundedImageView
        android:id="@+id/sample_image_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        android:src="@drawable/sample_image_view"
        app:cornerRadius="@dimen/hotseat_background_corner"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/switch_enable_liquid_glass"/>
    <com.luutinhit.launcher6.util.RealTimeBlurRoundedView
        android:id="@+id/sample_search_view"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_margin="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/sample_image_view"
        app:layout_constraintEnd_toEndOf="@+id/sample_image_view"
        app:layout_constraintStart_toStartOf="@+id/sample_image_view"
        app:realtimeBlurRoundCornerRadius="30dp"
        app:roundBottomLeft="true"
        app:roundBottomRight="true"
        app:roundCornerRadius="25dp"
        app:roundTopLeft="true"
        app:roundTopRight="true"/>
    <ImageView
        android:id="@+id/sample_ic_search"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="5dp"
        android:src="@drawable/ic_search"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="@+id/sample_search_view"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="@+id/sample_search_view"
        app:layout_constraintTop_toTopOf="@+id/sample_search_view"
        app:tint="@color/gray"/>
    <TextView
        android:textColor="@color/gray"
        android:id="@+id/tv_search_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@android:string/search_go"
        app:layout_constraintBottom_toBottomOf="@+id/sample_search_view"
        app:layout_constraintStart_toEndOf="@+id/sample_ic_search"
        app:layout_constraintTop_toTopOf="@+id/sample_search_view"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/custom_liquid_glass_effect"
        android:background="@drawable/bg_control_card"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="30dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sample_image_view">
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_layers"
            android:contentDescription="@null"
            android:layout_marginEnd="8dp"/>
        <androidx.appcompat.widget.AppCompatSeekBar
            android:id="@+id/liquid_glass_change"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:maxHeight="5dp"
            android:max="100"
            android:progressDrawable="@drawable/seekbar_progress"
            android:minHeight="5dp"
            android:thumb="@drawable/bg_slider_thumb"
            android:thumbOffset="10dp"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:splitTrack="false"
            android:thumbTint="@null"/>
        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_layers_filled"
            android:contentDescription="@null"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
